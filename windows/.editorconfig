# Правила анализа для Windows-порта.
#
# ⚠️ CA1838 ЗДЕСЬ НЕ «ХОРОШИЙ СТИЛЬ», А ЗАЩИТА ОТ КОНКРЕТНОЙ АВАРИИ. Именно этот дефект уронил
# программу на живой машине: QueryFullProcessImageNameW с буфером StringBuilder завершал процесс
# нарушением доступа — молча, без исключения, невидимо для .NET.
#
# Механизм описан у Microsoft: маршалинг StringBuilder ВСЕГДА создаёт нативную копию буфера
# (выделить, скопировать туда, вызвать, скопировать обратно в новый управляемый массив), и
# расхождение между заявленным размером и настоящим всплывает позже, в стороне от места ошибки.
#
# По умолчанию правило выключено. Ставим ошибкой, а не предупреждением: предупреждение в этом
# проекте означало бы «когда-нибудь посмотрим», а цена ошибки — процесс, исчезающий у человека
# посреди работы.
root = true

[*.cs]
dotnet_diagnostic.CA1838.severity = error
