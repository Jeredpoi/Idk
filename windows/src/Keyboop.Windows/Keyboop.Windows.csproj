<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Позволяет собирать Windows-таргет на не-Windows машине (CI на Linux, проверка компиляции).
      Запускать приложение всё равно можно только под Windows — оно завязано на user32/WASAPI.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Захват микрофона через WASAPI. -->
    <PackageReference Include="NAudio" Version="2.3.0" />

    <!--
      Whisper.net — обёртка над тем же whisper.cpp, что стоит в macOS-версии, поэтому распознавание
      и пунктуация ведут себя одинаково. Runtime-пакет несёт нативные библиотеки под CPU.
      Для видеокарты добавьте Whisper.net.Runtime.Cuda или .Vulkan — код менять не нужно.
    -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />

    <!--
      DPAPI для шифрования истории диктовок. Отдельным пакетом, потому что в общий состав .NET
      он не входит: механизм есть только у Windows.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Keyboop.Core/Keyboop.Core.csproj" />
  </ItemGroup>

  <!--
    Языковые данные (триграммы и словари) берём НАПРЯМУЮ из macOS-версии — формат тот же,
    конвертация не нужна, и копия в репозитории не заводится. Пять мегабайт, читаются лениво.
  -->
  <ItemGroup>
    <!--
      ⚠️ CopyToPublishDirectory ОБЯЗАТЕЛЕН, а не дублирует предыдущую строку.
      CopyToOutputDirectory кладёт файлы рядом со сборкой при обычном build; публикация
      (dotnet publish) — отдельный набор правил, и без явного указания данные могли туда не
      доехать. А без словарей детектор не переключает НИ ОДНОГО слова — и делает это молча,
      что со стороны неотличимо от «программа не работает».
    -->
    <Content Include="../../../Sources/Keyboop/Resources/*.json"
             Link="data/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
