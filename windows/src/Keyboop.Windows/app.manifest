<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="Keyboop.Windows" />

  <!--
    ⚠️ Запускаем БЕЗ повышения прав (asInvoker), и это осознанно.

    Соблазн попросить администратора велик: низкоуровневый перехватчик клавиатуры не видит ввод
    в окнах процессов, которые работают с более высокими правами (диспетчер задач, установщики,
    консоль администратора). Но приложение, постоянно висящее в трее с правами администратора и
    читающее каждое нажатие клавиши, — это ровно та программа, которой нельзя доверять. Цена
    отказа честная и понятная: в окнах с повышенными правами хоткей диктовки не сработает.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 и 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- Реальные пиксели на мониторах с масштабированием — иначе значок и подсказки размыты. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

</assembly>
